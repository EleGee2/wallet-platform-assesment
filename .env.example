# Server
PORT=3000

# MongoDB - source of truth for wallets, transactions, ledger entries, transfers, outbox
# Wallet/transfer writes use multi-document transactions, so Mongo must be running as a
# replica set (even a single-node one) - see `docker-compose up -d mongo`, not a bare mongod.
MONGODB_URI=mongodb://localhost:27017/wallet-platform?replicaSet=rs0&directConnection=true

# Redis - wallet balance read-through cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=3600

# RabbitMQ - asynchronous settlement / domain events
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=wallet.events
RABBITMQ_TRANSFER_QUEUE=transfer.events.queue
# Dead-letter exchange/queue for transfer events that fail processing twice
RABBITMQ_DEAD_LETTER_EXCHANGE=wallet.events.dlx
RABBITMQ_DEAD_LETTER_QUEUE=transfer.events.dlq

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s

# Rate limiting - global default (Redis-backed, shared across instances)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Workers
OUTBOX_RELAY_INTERVAL_MS=2000
PENDING_TRANSFER_SWEEP_INTERVAL_MS=5000
PENDING_TRANSFER_TIMEOUT_MS=60000
